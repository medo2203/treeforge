{
  "name": "treeforge",
  "displayName": "TreeForge",
  "description": "Create folder structures from text representations with support for tree visualization characters",
  "version": "1.1.0",
  "publisher": "MohamedBouzraa",
  "repository": {
    "type": "git",
    "url": "https://github.com/medo2203/treeforge.git"
  },
  "bugs": {
    "url": "https://github.com/medo2203/treeforge/issues"
  },
  "homepage": "https://github.com/medo2203/treeforge#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Snippets",
    "AI"
  ],
  "keywords": [
    "folder structure",
    "directory",
    "file system",
    "project scaffolding",
    "code generator"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#404A42",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "treeforge.create",
        "title": "TreeForge: Create Folder Structure"
      },
      {
        "command": "treeforge.preview",
        "title": "TreeForge: Preview Structure"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "treeforge.create",
          "group": "TreeForge",
          "when": "editorTextFocus"
        },
        {
          "command": "treeforge.preview",
          "group": "TreeForge",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "treeforge.create",
          "group": "TreeForge",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "TreeForge",
      "properties": {
        "treeforge.tabWidth": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "How many columns a tab character counts for when working out nesting depth."
        },
        "treeforge.onConflict": {
          "type": "string",
          "default": "skip",
          "enum": [
            "skip",
            "overwrite",
            "abort"
          ],
          "enumDescriptions": [
            "Leave existing files untouched.",
            "Replace existing files with empty ones.",
            "Stop without creating anything else."
          ],
          "description": "What to do when a file that TreeForge wants to create already exists."
        },
        "treeforge.revealInOSAfterCreate": {
          "type": "boolean",
          "default": false,
          "description": "Reveal the target folder in the OS file manager after creating a structure."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.17.6",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.14.0",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
